# Record copy of /root/llm/systemd/vllm-1cat.service -> BL1 fast-load variant.
# Original is READ-ONLY (red line). Delta vs the delivered unit: model paths
# moved to the LOCAL test NVMe for fast loading (diskless box, NFS rootfs is
# ~18 min per 32 GB load; NVMe ~1-2 min). Model content verified identical
# (config.json byte-same 51350 B, 29G both) => numbers caliber unchanged.
#   --model /root/llm/models/Qwen3.8-27B-FP8            -> /mnt/3.84t/Qwen3.8-27B-FP8
#   --chat-template .../chat_template.jinja             -> /mnt/3.84t/... (same file)
#   --speculative-config model /root/llm/models/Qwen3.8-27B-DFlash2
#                           -> /mnt/3.84t/Qwen3.8-27B-DFlash2-FP8
# Executed via p0-scripts/bl1-run.sh (WITH_SPEC=1 standard line / =0 decomposition).
# All other args verbatim from the delivered unit.
[Unit]
Description=1Cat-vLLM Qwen3.8-27B-FP8 DFlash2 256K (fast-load test copy)
Wants=network-online.target
Requires=1cat-gpu-init.service
After=network-online.target 1cat-gpu-init.service
RequiresMountsFor=/root/llm/ac922env/1cat-20260907 /mnt/3.84t /root/llm/cache

[Service]
EnvironmentFile=/root/llm/systemd/1cat-runtime.env
Environment="CUDA_VISIBLE_DEVICES=0,1,3,4"
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

ExecStart=/root/llm/ac922env/1cat-20260907/venv/bin/python -m vllm.entrypoints.openai.api_server \
    --model /mnt/3.84t/Qwen3.8-27B-FP8 \
    --served-model-name Qwen3.8-27B-FP8 \
    --trust-remote-code \
    --attention-backend FLASH_ATTN_V100 \
    --tensor-parallel-size 4 \
    --dtype half \
    --kv-cache-dtype fp8_e5m2 \
    --gpu-memory-utilization 0.905 \
    --max-model-len 262144 \
    --max-num-seqs 1 \
    --enable-chunked-prefill \
    --enable-prefix-caching \
    --max-num-batched-tokens 2048 \
    --limit-mm-per-prompt '{"image":999,"video":0}' \
    --mm-processor-kwargs '{"max_pixels":2073680}' \
    --mm-processor-cache-gb 0 \
    --speculative-config '{"method":"dflash","model":"/mnt/3.84t/Qwen3.8-27B-DFlash2-FP8","kv_cache_dtype":"auto","draft_sample_method":"probabilistic"}' \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder \
    --reasoning-parser qwen3 \
    --chat-template /mnt/3.84t/Qwen3.8-27B-FP8/chat_template.jinja \
    --default-chat-template-kwargs '{"enable_thinking":true,"preserve_thinking":true,"reasoning_effort":"xhigh"}' \
    --host 0.0.0.0 \
    --port 8000 \
    --api-key sk-REDACTED-use-key-from-original-unit

Restart=on-failure
RestartSec=15s
TimeoutStopSec=120s
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
