+// Device-side push path, opt-in with GGML_CUDA_AR_DEVICE=1.  Serves small
+// reductions only: a call larger than the capacity is left to the regular
+// implementation, which keeps the large prefill reductions on NCCL.
+static bool ggml_backend_cuda_comm_init_device(ggml_backend_cuda_comm_context * ret) {
+    if (getenv("GGML_CUDA_AR_DEVICE") == nullptr) {
+        return false;
+    }
+
+    const size_t cap = 262144; // floats per rank shard (1 MiB)
+
+    ret->ar_device = ggml_cuda_ar_device_init(ret->dev_ids.data(), ret->dev_ids.size(), cap);
+    if (ret->ar_device == nullptr) {
+        (void) cudaGetLastError();
+        GGML_LOG_WARN("device-side AllReduce init failed; using the regular path\n");
+        return false;
+    }
+
+    ret->try_allreduce = ggml_backend_cuda_comm_try_allreduce_device;
+    GGML_LOG_INFO("device-side push AllReduce enabled (cap %zu floats)\n", cap);
+    return true;
+}
+
 static void ggml_backend_cuda_comm_init_nccl(ggml_backend_cuda_comm_context * ret) {
+    if (ggml_backend_cuda_comm_init_device(ret)) {
+        return;
+    }
 #ifdef GGML_USE_NCCL
     // Disabling NCCL path when CUDA virtual devices are in use since NCCL requires one distinct physical GPU per rank.
     const ggml_cuda_device_info & info = ggml_cuda_info();
