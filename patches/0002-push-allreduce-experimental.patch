         ggml_tensor           ** tensors) {
     GGML_ASSERT(p != nullptr);
 
+    if (p->push_ready && ggml_cuda_ar_allreduce_push(p, backends, tensors)) {
+        return true;
+    }
+
     const int n = p->n_devices;
-    GGML_ASSERT(n == 2);
+    // 3 devices are only served by the push path above; if it declined this tensor, let the caller
+    // fall back instead of aborting.
+    if (n != 2) {
+        return false;
+    }
 
     const ggml_type input_type = tensors[0]->type;
     GGML_ASSERT(input_type == GGML_TYPE_F32 || input_type == GGML_TYPE_F16 || input_type == GGML_TYPE_BF16);
