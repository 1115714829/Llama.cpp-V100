+// One-shot push allreduce over UVA peer pointers, for exactly 3 devices.  Each block pushes its
+// slice to both peers, publishes a per-block arrival epoch, spins for the peers' epochs and reduces
+// in place.  The epochs live in device memory and only grow, so the kernel is safe to capture into
+// a CUDA graph and replay.
+__global__ void ggml_cuda_ar_push_kernel(
+        float4 * __restrict__ buf,
+        float4 * __restrict__ dst_a, float4 * __restrict__ dst_b,
+        unsigned int * __restrict__ pub_a, unsigned int * __restrict__ pub_b,
+        const unsigned int * __restrict__ spin_a, const unsigned int * __restrict__ spin_b,
+        const float4 * __restrict__ peer_a, const float4 * __restrict__ peer_b,
+        int n4, unsigned int * __restrict__ epoch, int flag_stride, int * __restrict__ err, int bound) {
+    const int bid = blockIdx.x;
+
+    __shared__ unsigned int ep_sh;
+    if (threadIdx.x == 0) {
+        ep_sh = atomicAdd(&epoch[bid], 1u) + 1u;
+    }
+    __syncthreads();
+    const unsigned int ep = ep_sh;
+
+    const int stride = gridDim.x * blockDim.x;
+    for (int i = bid * blockDim.x + threadIdx.x; i < n4; i += stride) {
+        const float4 v = buf[i];
+        dst_a[i] = v;
+        dst_b[i] = v;
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        pub_a[bid*flag_stride] = ep;
+        pub_b[bid*flag_stride] = ep;
+
+        int spins = 0;
+        while (spins < bound && *(volatile const unsigned int *) &spin_a[bid*flag_stride] < ep) { spins++; }
+        while (spins < bound && *(volatile const unsigned int *) &spin_b[bid*flag_stride] < ep) { spins++; }
+        if (spins >= bound) { *err = 1; }
+    }
+    __syncthreads();
+    __threadfence_system();
+
+    for (int i = bid * blockDim.x + threadIdx.x; i < n4; i += stride) {
+        const float4 a = buf[i];
+        const float4 b = peer_a[i];
+        const float4 c = peer_b[i];
+        buf[i] = make_float4(a.x + b.x + c.x, a.y + b.y + c.y, a.z + b.z + c.z, a.w + b.w + c.w);
+    }
+}
+
+static bool ggml_cuda_ar_push_init(ggml_cuda_ar_pipeline * p) {
+    if (p->push_ready) {
+        return true;
+    }
+    if (p->n_devices != 3) {
+        return false;
+    }
+    if (ggml_cuda_ar_env_u64("GGML_CUDA_AR_PUSH", 0) == 0) {
+        return false;
+    }
+
+    p->push_slot_bytes = (size_t) ggml_cuda_ar_env_u64("GGML_CUDA_AR_PUSH_BYTES",   8u * 1024u * 1024u);
+    p->push_n_blocks   = (int)    ggml_cuda_ar_env_u64("GGML_CUDA_AR_PUSH_BLOCKS",  40);
+    p->push_n_threads  = (int)    ggml_cuda_ar_env_u64("GGML_CUDA_AR_PUSH_THREADS", 256);
+
+    const int    nd        = p->n_devices;
+    const size_t epoch_off = p->push_slot_bytes * (size_t) nd;
+    const size_t flags_off = epoch_off + sizeof(unsigned int) * (size_t) p->push_n_blocks;
+    const size_t per_dev   = flags_off + sizeof(unsigned int) * (size_t) p->push_n_blocks * (size_t) p->push_flag_stride * (size_t) nd;
+
+    for (int i = 0; i < nd; ++i) {
+        ggml_cuda_set_device(p->devices[i]);
+        for (int j = 0; j < nd; ++j) {
+            if (i == j) {
+                continue;
+            }
+            const cudaError_t e = cudaDeviceEnablePeerAccess(p->devices[j], 0);
+            if (e == cudaErrorPeerAccessAlreadyEnabled) {
+                // Peer access was already enabled (P2P path did it).  Not a failure, but the sticky
+                // error state must be cleared here or a later cudaGetLastError() in the launch path
+                // reports it and aborts.
+                (void) cudaGetLastError();
+            } else if (e != cudaSuccess) {
+                GGML_LOG_WARN("%s: peer access %d -> %d failed: %s\n", __func__, i, j, cudaGetErrorString(e));
+                return false;
+            }
+        }
+        void * mem = nullptr;
+        if (cudaMalloc(&mem, per_dev) != cudaSuccess) {
+            GGML_LOG_WARN("%s: cudaMalloc(%zu) failed on device %d\n", __func__, per_dev, p->devices[i]);
+            return false;
+        }
+        if (cudaMemset(mem, 0, per_dev) != cudaSuccess) {
+            return false;
+        }
+        p->push_mem[i] = mem;
+
+        // spin-timeout flag, queried by hand when a hang is suspected
+        void * err_mem = nullptr;
+        if (cudaMalloc(&err_mem, sizeof(int)) != cudaSuccess) {
+            return false;
+        }
+        if (cudaMemset(err_mem, 0, sizeof(int)) != cudaSuccess) {
+            return false;
+        }
+        p->push_err_dev[i] = err_mem;
+    }
+
+    for (int i = 0; i < nd; ++i) {
+        p->push_epoch[i] = (unsigned int *) ((char *) p->push_mem[i] + epoch_off);
+        p->push_flags[i] = (unsigned int *) ((char *) p->push_mem[i] + flags_off);
+        for (int j = 0; j < nd; ++j) {
+            p->push_peer[i][j]       = (char *) p->push_mem[j];
+            p->push_peer_flags[i][j] = (unsigned int *) ((char *) p->push_mem[j] + flags_off);
+        }
+    }
+
+    p->push_ready = true;
+    GGML_LOG_INFO("%s: push allreduce enabled (slot=%zu B, blocks=%d, threads=%d, per_dev=%zu B)\n",
+                  __func__, p->push_slot_bytes, p->push_n_blocks, p->push_n_threads, per_dev);
+    return true;
+}
+
+// Returns false when the tensor does not fit the push path, so the caller can fall back.
+static bool ggml_cuda_ar_allreduce_push(
+        ggml_cuda_ar_pipeline * p,
+        ggml_backend_t        * backends,
+        ggml_tensor           ** tensors) {
+    const int    nd    = p->n_devices;
+    const size_t bytes = ggml_nbytes(tensors[0]);
+    if (tensors[0]->type != GGML_TYPE_F32 || bytes == 0 || bytes > p->push_slot_bytes) {
+        return false;
+    }
+    if (bytes % sizeof(float4) != 0) {
+        return false;
+    }
+    const int n4 = (int) (bytes / sizeof(float4));
+
+
+    for (int i = 0; i < nd; ++i) {
+        ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backends[i]->context;
+        ggml_cuda_set_device(ctx->device);
+        cudaStream_t stream = ctx->stream();
+
+        // A shard that is not marked compute holds padding, not a partial sum, so it must not
+        // contribute. The NCCL path zeroes these before reducing; without this the padding was
+        // summed in and the result was wrong (same class as upstream PR 23480).
+        if ((tensors[i]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            CUDA_CHECK(cudaMemsetAsync(tensors[i]->data, 0, ggml_nbytes(tensors[i]), stream));
+        }
+
+        const int j1 = (i + 1) % nd;
+        const int j2 = (i + 2) % nd;
+
+        ggml_cuda_ar_push_kernel<<<p->push_n_blocks, p->push_n_threads, 0, stream>>>(
+                (float4 *) tensors[i]->data,
+                (float4 *) (p->push_peer[i][j1] + (size_t) i * p->push_slot_bytes),
+                (float4 *) (p->push_peer[i][j2] + (size_t) i * p->push_slot_bytes),
+                p->push_peer_flags[i][j1] + (size_t) i * p->push_n_blocks * p->push_flag_stride,
+                p->push_peer_flags[i][j2] + (size_t) i * p->push_n_blocks * p->push_flag_stride,
+                p->push_flags[i] + (size_t) j1 * p->push_n_blocks * p->push_flag_stride,
+                p->push_flags[i] + (size_t) j2 * p->push_n_blocks * p->push_flag_stride,
+                (const float4 *) (p->push_peer[i][j1] + (size_t) j1 * p->push_slot_bytes),
+                (const float4 *) (p->push_peer[i][j2] + (size_t) j2 * p->push_slot_bytes),
+                n4, p->push_epoch[i], p->push_flag_stride, (int *) p->push_err_dev[i], 2000000000);
+    }
+    return true;
+}
+
 bool ggml_cuda_ar_allreduce(
         ggml_cuda_ar_pipeline * p,
